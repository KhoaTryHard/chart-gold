# Auth.js / Google OAuth
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret
# Auth.js host trust is safe for Vercel's forwarded host setup
AUTH_TRUST_HOST=true
# Comma-separated, case-insensitive administrator emails
ADMIN_EMAILS=admin@example.com

# AI provider. Keep Gemini as the safe local/default provider until a Hermes
# gateway is deployed and its three values below are configured.
AI_PROVIDER=gemini
# Only required when AI_PROVIDER=gemini.
GEMINI_API_KEY=your-gemini-api-key
# Optional Gemini 3 model overrides. Defaults: gemini-3.6-flash /
# gemini-3.5-flash. Gemini 3 models use thinking levels instead of the
# deprecated temperature/top-p/top-k sampling parameters.
GEMINI_MODEL=
GEMINI_DEEP_MODEL=
# Only required when AI_PROVIDER=openai.
# OPENAI_API_KEY=your-openai-api-key

# Hermes is an OpenAI-compatible gateway. HERMES_BASE_URL must be the public
# HTTPS gateway root (with or without a trailing /v1), not a localhost URL.
# HERMES_API_KEY is the bearer key configured by the gateway administrator.
# HERMES_MODEL must match a model exposed by the gateway's /v1/models endpoint.
# Only required when AI_PROVIDER=hermes.
HERMES_BASE_URL=
HERMES_API_KEY=
HERMES_MODEL=
