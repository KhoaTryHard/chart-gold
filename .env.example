# Auth.js / Google OAuth
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret
# Auth.js host trust is safe for Vercel's forwarded host setup
AUTH_TRUST_HOST=true
# Comma-separated, case-insensitive administrator emails
ADMIN_EMAILS=admin@example.com

# AI provider (Gemini is the default; OpenAI remains an optional adapter)
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
# Optional stable model overrides. Defaults: gemini-2.5-flash / gemini-2.5-pro.
GEMINI_MODEL=
GEMINI_DEEP_MODEL=
# Only required when AI_PROVIDER=openai.
# OPENAI_API_KEY=your-openai-api-key

# Only required when AI_PROVIDER=hermes. No Hermes gateway is bundled yet.
HERMES_BASE_URL=
HERMES_API_KEY=
HERMES_MODEL=
