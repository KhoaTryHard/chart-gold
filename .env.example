# Auth.js / Google OAuth
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret
GOOGLE_SITE_VERIFICATION=
# Disable automatic/history page views in the GA4 web stream before enabling this ID.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
AUTH_URL=https://www.vanghomnay.online
# Auth.js host trust is safe for Vercel's forwarded host setup
AUTH_TRUST_HOST=true
# Required to authorize the production market-history cron endpoint.
CRON_SECRET=replace-with-a-long-random-secret
# Comma-separated, case-insensitive administrator emails. Admins keep unlimited access.
ADMIN_EMAILS=admin@example.com

# Every verified Google user receives the community allowance; the legacy alias
# remains available only for a controlled rollback.
B2C_SUBSCRIPTIONS_ENABLED=true
SITE_URL=https://www.vanghomnay.online
B2C_AI_ENABLED=true
AI_EXPERIENCE_V2_ENABLED=true
# Donation checkout is independent from AI access and subscription sales.
DONATIONS_ENABLED=true
# Keep false for the first 90-day community experiment. Existing paid periods still work.
SUBSCRIPTIONS_SALES_ENABLED=false
# First paid beta exposes only the Plus plan (99,000 VND / 30 days / 20
# completed analyses). Set false only when the full catalog is intentionally
# reopened after cost and quality validation.
SUBSCRIPTION_BETA_SINGLE_PLAN=true
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# auto routes verified price/investment questions to Hermes and current
# macro/research questions to Gemini. Fixed modes remain available for diagnostics.
AI_PROVIDER=auto
# Required for Gemini research in auto mode (use a billed API project).
GEMINI_API_KEY=your-gemini-api-key
# Optional Gemini 3 model overrides. Auto defaults to gemini-3.6-flash,
# with higher thinking for deep questions. Gemini 3 uses thinking levels instead of
# deprecated temperature/top-p/top-k sampling parameters.
GEMINI_MODEL=
GEMINI_DEEP_MODEL=
# Optional OpenAI fixed mode; auto uses Hermes instead.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_DEEP_MODEL=gpt-5.4-2026-03-05

# Hermes is an OpenAI-compatible gateway. HERMES_BASE_URL must be the public
# HTTPS gateway root (with or without a trailing /v1), not a localhost URL.
# HERMES_API_KEY is the bearer key configured by the gateway administrator.
# HERMES_MODEL must match a model exposed by the gateway's /v1/models endpoint.
# Only required when AI_PROVIDER=hermes.
HERMES_BASE_URL=
HERMES_API_KEY=
HERMES_MODEL=

# Editorial automation uses a separate Gemini account for text and images.
# It never falls back to the chatbot GEMINI_API_KEY or another provider.
EDITORIAL_GEMINI_API_KEY=
EDITORIAL_GEMINI_MODEL=gemini-3.6-flash
# Brand library + Admin upload; no Gemini image billing is required.
EDITORIAL_IMAGE_MODE=brand-upload

# QStash schedules signed worker calls for editorial scouting, drafting and
# publication. Set the three signing values in Vercel before enabling it.
EDITORIAL_AUTOMATION_ENABLED=false
HERMES_EDITORIAL_ENABLED=false
# Narrated-video assets require the existing editorial HMAC/owner gates too.
# Enable only after the bot's voice, credits and Composio TTS checks succeed.
HERMES_VIDEO_ENABLED=false
HERMES_EDITORIAL_SECRET=
HERMES_EDITORIAL_NEXT_SECRET=
HERMES_EDITORIAL_OWNER_ID=
HERMES_EDITORIAL_CHAT_ID=
HERMES_EDITORIAL_PAGE_ID=1262243656966414
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# A private Vercel Blob store keeps Admin-uploaded editorial images inaccessible
# until their approved revision becomes public through the editorial media route.
# A linked Vercel store can instead inject BLOB_STORE_ID + VERCEL_OIDC_TOKEN.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# SePay live webhook / QR settings. Never commit real values.
SEPAY_WEBHOOK_SECRET=
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_HOLDER=
SEPAY_PAYMENT_PREFIX=KT
DONATION_PAYMENT_PREFIX=DN

# Cash ceilings for reader AI during the community experiment. Free and paid
# beta budgets are isolated; keep their combined totals inside the 1,000,000
# VND/month operating ceiling together with hosting, data, payments and editorial.
AI_MONTHLY_BUDGET_VND=300000
AI_DAILY_BUDGET_VND=10000
AI_SUBSCRIPTION_MONTHLY_BUDGET_VND=300000
AI_SUBSCRIPTION_DAILY_BUDGET_VND=30000
AI_COMMUNITY_MONTHLY_LIMIT=3
# A conservative fallback while provider token pricing is unavailable.
AI_COST_RESERVATION_VND=1000
# Optional provider price overrides. When both are set (including 0 for a
# verified free provider), reservations use capability-specific token ceilings.
OPERATING_COST_MONTHLY_VND=
AI_INPUT_COST_PER_1K_VND=
AI_OUTPUT_COST_PER_1K_VND=

# Editorial drafts are budgeted separately from reader AI usage. Image uploads
# use hosting/storage tracking and do not reserve Gemini image credits.
EDITORIAL_MODEL=
EDITORIAL_MONTHLY_BUDGET_VND=300000
EDITORIAL_DAILY_BUDGET_VND=10000
# Upper-bound reservations are used until the provider reports usage.
EDITORIAL_COST_RESERVATION_VND=2000
EDITORIAL_IMAGE_COST_RESERVATION_VND=0
EDITORIAL_TEXT_INPUT_VND_PER_1K=50
EDITORIAL_TEXT_OUTPUT_VND_PER_1K=300
EDITORIAL_MAX_OUTPUT_TOKENS=2000
