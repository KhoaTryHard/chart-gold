# Auth.js / Google OAuth
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret
# Auth.js host trust is safe for Vercel's forwarded host setup
AUTH_TRUST_HOST=true
# Comma-separated, case-insensitive administrator emails
ADMIN_EMAILS=admin@example.com

# AI provider (OpenAI is the default; Hermes is a future adapter seam)
AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key

# Only required when AI_PROVIDER=hermes. No Hermes gateway is bundled yet.
HERMES_BASE_URL=
HERMES_API_KEY=
HERMES_MODEL=
